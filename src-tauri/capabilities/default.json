{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {"identifier":"opener:allow-open-path","allow":[{"path":"**"}]},
    "dialog:default",
    "allow-get-platform",
    "allow-get-home-dir",
    "allow-pick-workspace-folder",
    "allow-workspace-path",
    "allow-kill-process-on-port",
    "allow-start-opencode-serve",
    "allow-search-skills-via-cli",
    "allow-search-skills-via-api",
    "allow-install-skill-from-source",
"allow-uninstall-skill",
    "allow-read-attachment-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/opencode",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize"
  ]
}
